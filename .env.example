# App
APP_SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
DATABASE_URL=sqlite:///./data/dashboard.db
# DATABASE_URL=postgresql://user:pass@db:5432/video_dashboard

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# AutoClip
# Path to autoclip binary or python -m entry
AUTOCLIP_CMD=autoclip
# Or full: python -m backend.cli  (if running from autoclip repo)
AUTOCLIP_DATA_DIR=/data/autoclip
AUTOCLIP_DEFAULT_PLATFORM=youtube_long
# Target output length in seconds (approx)
TARGET_SHORT_DURATION=600
MIN_CLIP_SCORE=0.55

# Storage
UPLOAD_DIR=/data/uploads
OUTPUT_DIR=/data/outputs
TEMP_DIR=/data/temp

# YouTube
YOUTUBE_CLIENT_SECRETS=/secrets/client_secrets.json
YOUTUBE_TOKEN_FILE=/secrets/youtube_token.json
YOUTUBE_CATEGORY_ID=22
YOUTUBE_PRIVACY=private
YOUTUBE_DEFAULT_TAGS=auto,clip,short

# Optional: use existing AutoClip Docker API instead of CLI
# AUTOCLIP_API_BASE=http://autoclip:8000

# Frontend origin (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
